# The assets repo the workshop writes into.
ASSETS_OWNER=juntaoli-dev
ASSETS_REPO=mayorly-assets

# In development, read slots straight from a local checkout so you need no
# credentials at all. Unset this in production to read from the GitHub API.
ASSETS_PATH=../assets

# GitHub App. This is what holds write access, so artists never need any.
# Create at https://github.com/settings/apps  ->  install it on the assets repo.
# Repository permissions needed: Contents read+write, Pull requests read+write, Metadata read.
GH_APP_ID=
# The PEM, with real newlines escaped as \n so it survives a one-line env var.
GH_APP_PRIVATE_KEY=

# Optional OAuth app, only used to capture the artist's handle for attribution.
# It never grants repo write.
GH_CLIENT_ID=
GH_CLIENT_SECRET=

PORT=8787
